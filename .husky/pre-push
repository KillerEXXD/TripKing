#!/bin/sh
# Pre-push gate: type-check, tests, coverage, test-policy compliance, prod build.
# Policy doc: docs/TEST_POLICY.md

# Branch sanity (twin of the pre-commit guard — see its comment for why).
branch="$(git branch --show-current 2>/dev/null)"
echo "🌿  Pushing branch: ${branch:-(detached HEAD)}"

echo "🔎  tsc --noEmit"
npx tsc --noEmit || { echo "❌ Type errors — fix before pushing."; exit 1; }

echo "🧪  npm run test:coverage (enforces coverage thresholds)"
npm run test:coverage || { echo "❌ Tests or coverage thresholds failed — fix before pushing."; exit 1; }

echo "📋  test-required gate (docs/TEST_POLICY.md)"
node scripts/check-tests-required.cjs || exit 1

echo "🛡️   PII / public-scope gate (#114 item 10)"
node scripts/check-pii-public-scope.cjs || exit 1

echo "🏗️   npm run build"
npm run build || { echo "❌ Build failed — fix before pushing."; exit 1; }

echo "✅  tsc + tests + coverage + policy + build all green"
