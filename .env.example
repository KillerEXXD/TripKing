# Trip King — environment variables
# Copy to .env.development for local development (it's gitignored)

# Supabase (Postgres + Auth + Storage + Realtime + Edge Functions)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...   # or the legacy JWT anon key
# Optional — only for migrations / admin scripts, never shipped to the browser:
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Sentry (error tracking)
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (analytics)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google Maps (Places + Distance Matrix)
VITE_GOOGLE_MAPS_API_KEY=

# Daily.co (video-call verification)
VITE_DAILY_DOMAIN=

# MSG91 / Twilio (SMS / OTP)
VITE_SMS_PROVIDER=msg91
