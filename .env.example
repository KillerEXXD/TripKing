# TripKing — environment variables
# Copy to .env.development for local development (it's gitignored)

# The browser app talks to the REST API, not Supabase directly (CLAUDE.md §API).
# Dev: leave VITE_API_BASE_URL blank to use the Vite /api proxy (vite.config.ts).
VITE_API_BASE_URL=
VITE_TRIPKING_API_KEY=
# VITE_USE_MOCK_API=true   # point /api at a local mock server during early dev

# Supabase — used by edge functions + migration/admin scripts only, never the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # bypasses RLS — keep secret
# (the old ADMIN_API_KEY stopgap is gone — /admin/* now requires a role=admin Bearer; the Supabase function secret has been unset)

# Geocoder for the /places search proxy — Supabase function secrets (set via `supabase secrets set`),
# never shipped to the browser. PLACES_PROVIDER ∈ locationiq | geoapify | nominatim | google.
# Currently configured: locationiq (the live provider — key set as a Supabase function secret).
# Default (unset) falls back to `nominatim` (OSM, no key, dev-grade).
# PLACES_PROVIDER=locationiq
# PLACES_API_KEY=

# Sentry (error tracking)
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (analytics)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google Maps (Places + Distance Matrix)
VITE_GOOGLE_MAPS_API_KEY=

# Daily.co (video-call verification)
VITE_DAILY_DOMAIN=

# MSG91 / Twilio (SMS / OTP)
VITE_SMS_PROVIDER=msg91

# Qase test management — generate at https://app.qase.io (Profile → API tokens)
QASE_API_TOKEN=
QASE_PROJECT_CODE=TRIPKINGAP

# Qase webhook secret — for the /webhook-qase edge function. The function verifies
# HMAC-SHA256 of every Qase payload with this value. Set it via `supabase secrets set
# QASE_WEBHOOK_SECRET=<value>` AND paste the same value into the webhook config in the
# Qase project (https://app.qase.io/project/TRIPKINGAP/settings/webhooks). See
# docs/QASE_BUG_PIPELINE.md.
QASE_WEBHOOK_SECRET=
