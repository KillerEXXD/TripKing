# DriverMahal — required environment variables
# Copy to .env.local for local development

# Supabase (Postgres + Auth + Storage + Realtime + Edge Functions)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# DriverMahal API
VITE_DRIVERMAHAL_API_URL=https://api.drivermahal.in
VITE_DRIVERMAHAL_API_KEY=

# Sentry (error tracking)
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (analytics)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google Maps (Places + Distance Matrix)
VITE_GOOGLE_MAPS_API_KEY=

# Daily.co (video-call verification)
VITE_DAILY_DOMAIN=

# MSG91 / Twilio (SMS / OTP)
VITE_SMS_PROVIDER=msg91
