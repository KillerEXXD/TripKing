{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PAT}" }
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com",
      "headers": { "Authorization": "Bearer ${VERCEL_MCP_TOKEN}" }
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase@latest"],
      "env": {
        "SUPABASE_URL": "https://saxcbebqxgatiktsebxw.supabase.co",
        "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}"
      }
    },
    "git": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-git"], "env": {} },
    "sequential-thinking": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"], "env": {} },
    "puppeteer": { "command": "npx", "args": ["-y", "@anthropic/mcp-server-puppeteer@latest"], "env": {} },
    "stitch": { "command": "npx", "args": ["-y", "@_davideast/stitch-mcp", "proxy"], "env": {} },
    "nanobanana": { "command": "npx", "args": ["-y", "@ycse/nanobanana-mcp"], "env": { "GOOGLE_AI_API_KEY": "${GOOGLE_AI_API_KEY}" } },
    "21st-dev-magic": { "command": "npx", "args": ["-y", "@21st-dev/magic@latest"], "env": { "TWENTY_FIRST_API_KEY": "${TWENTY_FIRST_API_KEY}" } }
  }
}
