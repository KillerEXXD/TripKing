{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "-p", "@artificable/github-mcp-server", "artificable-github-mcp-server", "stdio"]
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com",
      "headers": { "Authorization": "Bearer ${VERCEL_MCP_TOKEN}" }
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase@latest", "--read-only", "--project-ref=saxcbebqxgatiktsebxw"],
      "env": { "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}" }
    },
    "git": { "command": "python", "args": ["-m", "mcp_server_git", "--repository", "c:/Apps/TripKing"], "env": {} },
    "sequential-thinking": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"], "env": {} },
    "puppeteer": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-puppeteer"], "env": {} },
    "stitch": { "command": "npx", "args": ["-y", "@_davideast/stitch-mcp", "proxy"], "env": {} },
    "nanobanana": { "command": "npx", "args": ["-y", "@ycse/nanobanana-mcp"], "env": { "GOOGLE_AI_API_KEY": "${GOOGLE_AI_API_KEY}" } },
    "21st-dev-magic": { "command": "npx", "args": ["-y", "@21st-dev/magic@latest"], "env": { "TWENTY_FIRST_API_KEY": "${TWENTY_FIRST_API_KEY}" } },
    "context7": { "command": "npx", "args": ["-y", "@upstash/context7-mcp@latest"], "env": {} }
  }
}
